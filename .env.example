# Скопируйте в .env: cp .env.example .env   (файл .env в git не попадает)
#
# Два режима:
#   demo       — локальный показ: docker compose up --build. Можно вообще без .env.
#   production — VPS: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#                Строки с пометкой [ОБЯЗАТЕЛЬНО СМЕНИТЬ] нужно заполнить своими значениями,
#                иначе API откажется стартовать (слабые и примерные значения не принимаются).
#                Пошагово — docs/DEPLOY_VPS.md.

# Режим: demo или production. В production оверлей docker-compose.prod.yml ставит его сам
APP_ENV=demo

# ---------- Домен и TLS (только production) ----------
# Доменное имя сервера: DNS-запись A → IP сервера. Caddy сам получит сертификат Let's Encrypt
DOMAIN=collector.example.ru

# ---------- PostgreSQL ----------
POSTGRES_DB=collector
POSTGRES_USER=collector
# [ОБЯЗАТЕЛЬНО СМЕНИТЬ] openssl rand -hex 24   (только буквы и цифры: пароль входит в адрес подключения)
POSTGRES_PASSWORD=change-me
# Порт БД на 127.0.0.1 — только в demo (в production не публикуется)
POSTGRES_PORT=5432

# ---------- API ----------
# Порт API на 127.0.0.1 — только в demo, для Swagger (в production не публикуется)
API_PORT=8000
# [ОБЯЗАТЕЛЬНО СМЕНИТЬ] секрет подписи JWT, не меньше 32 символов: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Срок жизни входа, минут (720 = смена 12 ч; в production не больше 1440)
JWT_EXPIRE_MINUTES=720
# Разрешённые источники для браузера. demo — адреса dev-серверов; production — https://<DOMAIN> (ставится сам)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Засевать демо-данные при старте, если база пустая. Без строки: demo — да, production — нет.
# Не раскомментируйте на сервере, если данные будут из копии БД (docs/DEPLOY_VPS.md, шаг 7)
# SEED_ON_START=true
# Масштаб демо-сида: demo (≈400 датчиков, 2 месяца) или small (для быстрых проверок)
SEED_SCALE=demo
LOG_LEVEL=info
# Swagger (/docs): в demo включён, в production выключен. true — включить явно (порт API всё равно закрыт)
# DOCS_ENABLED=false

# ---------- Симуляция потока и расписание ----------
# Симуляция — проигрывание суток по заранее рассчитанным прогнозам (онлайн-пересчёта моделью нет).
# Без строки: demo — включена, production — выключена. true — включить на сервере для показа (README, docs/DEPLOY_VPS.md)
# SIM_ENABLED=false
# Планировщик APScheduler в процессе API: такт симуляции (раз в секунду) и разметка исходов (раз в 30 минут).
# API запускается одним процессом uvicorn — с несколькими воркерами задания выполнялись бы в каждом
SCHEDULER_ENABLED=true
# OUTCOMES_INTERVAL_MINUTES=30

# ---------- Начальный администратор (production) ----------
# Создаётся при старте, если в базе нет активного администратора. Пароль — от 12 символов, не демо.
# После первого входа уберите ADMIN_PASSWORD из .env и перезапустите api.
# Остальные учётки: docker compose ... exec api python -m app.bootstrap user <логин> --role dispatcher
ADMIN_USERNAME=admin
# [ОБЯЗАТЕЛЬНО СМЕНИТЬ] openssl rand -base64 18
ADMIN_PASSWORD=

# ---------- Резервные копии (production, контейнер backup) ----------
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
BACKUP_DIR=./backups

# ---------- Фронтенд (Nginx) ----------
# Порт только для demo; в production фронтенд доступен через Caddy на 80/443
FRONTEND_PORT=8080
FRONTEND_USE_MOCKS=false

# ---------- Производительность ----------
# Пул соединений API с PostgreSQL: постоянных и временных сверх них. 10 + 30 выдерживают 40 одновременных
# пользователей (docs/LOADTEST.md); PostgreSQL по умолчанию принимает до 100 соединений
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=30

# ---------- LDAP / Active Directory ----------
# При LDAP_ENABLED=true вход — только через каталог: bind сервисной учёткой, поиск по LDAP_USER_FILTER, проверка
# пароля bind-ом пользователя, роли по группам LDAP_ROLE_GROUPS (все подходящие — роли складываются), область
# видимости по группам LDAP_SCOPE_GROUPS. Локальные пароли
# при включённом LDAP не проверяются; каталог недоступен или TLS не сходится — вход закрыт (503). Подробно —
# docs/SECURITY.md, живая проверка на OpenLDAP — deploy/ldap-test/. В production — только ldaps:// или StartTLS.
LDAP_ENABLED=false
LDAP_URL=ldaps://ldap.example.local:636
# StartTLS поверх ldap:// (для ldaps:// не нужен) и корневой сертификат каталога (PEM), если он не из системных
LDAP_START_TLS=false
LDAP_CA_FILE=
LDAP_BASE_DN=dc=example,dc=local
LDAP_BIND_DN=cn=service,dc=example,dc=local
LDAP_BIND_PASSWORD=
# AD: (sAMAccountName={username}); OpenLDAP: (uid={username})
LDAP_USER_FILTER=(sAMAccountName={username})
# Роли: «роль:группа» через запятую (группа — первая часть DN) или через «;» с полными DN группы.
# Роли заказчика: dispatcher_ods (ОДС, всё), dispatcher (район), technician (комплекс), manager (чтение в области),
# engineer (инженер данных, всё), admin
LDAP_ROLE_GROUPS=dispatcher_ods:cn=ods,dispatcher:cn=dispatchers,technician:cn=technicians,manager:cn=managers,engineer:cn=engineers,admin:cn=admins
# Область видимости: «id объекта:группа» (id района или объекта-комплекса из справочника объектов) через запятую
# или через «;» с полными DN. Нужна ролям с областью (диспетчер района, техник, руководитель): без подходящей
# группы они не входят (закрыто по умолчанию). Пример: район 5773 и комплекс «объект Альфа» (id 5) реальных данных
LDAP_SCOPE_GROUPS=5773:cn=district-south,5:cn=complex-alpha
# Группы пользователя: memberOf из записи + поиск групп этим фильтром ({user_dn} — DN пользователя, {username} — логин)
LDAP_GROUP_FILTER=(|(member={user_dn})(uniqueMember={user_dn}))
# Где искать группы; пусто — LDAP_BASE_DN
LDAP_GROUP_BASE_DN=
