// Рисунок: цикл работы сервиса — от данных до дообучения (две строки, чтобы читалось на А4)
digraph cycle {
  graph [rankdir=LR, fontname="PT Sans", nodesep=0.5, ranksep=0.55, pad=0.2, bgcolor=white, newrank=true];
  node  [shape=box, style="rounded,filled", fontname="PT Sans", fontsize=15, fillcolor="#e6f4ff", color="#1677ff", penwidth=1.5, margin="0.2,0.12", width=2.6];
  edge  [fontname="PT Sans", fontsize=13, color="#595959", penwidth=1.4];
  d  [label="1. Данные СМВУ\nжурнал событий 2022–2026"];
  m  [label="2. Модель LightGBM\n126 признаков,\nофлайн-конвейер"];
  p  [label="3. Прогноз на 24 ч\nвероятность, риск,\nвид отказа, причины"];
  r  [label="4. Рекомендация по ТО\nпрозрачные правила\n(проект, согласовать)"];
  s  [label="5. Решение диспетчера\nвыезд / ложное /\nнаблюдение + причина", fillcolor="#fff7e6", color="#d46b08"];
  o  [label="6. Исход через 24 ч\nсбылся ли отказ", fillcolor="#f6ffed", color="#389e0d"];
  f  [label="7. Выгрузка решений\nс исходами — набор\nдля дообучения", fillcolor="#f5f5f5", color="#8c8c8c"];
  { rank=same; d; f; }
  { rank=same; m; o; }
  { rank=same; p; s; }
  d -> m -> p -> r;
  // верхняя строка идёт справа налево (5 → 6 → 7): колонки заданы rank=same
  r -> s [constraint=false];
  s -> o [constraint=false];
  o -> f [constraint=false];
  f -> d [label="  переобучение\n  (вручную)", style=dashed];
}
